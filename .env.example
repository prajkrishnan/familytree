# --- required -------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Public URL exactly as seen by browsers (used for cookies, invite links and
# secure-cookie detection). Keep the https:// scheme in production.
BASE_URL=https://family.example.com

# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# With the sample nginx config proxying to 127.0.0.1, the default is correct.
TRUSTED_PROXIES=127.0.0.1,::1

# Optional. If unset, a one-time token is generated on first boot and written
# to /data/setup_token, and printed in the container log.
# SETUP_TOKEN=

# invite_only | passcode | open  (the admin can change this later in Settings)
REGISTRATION_MODE=invite_only

SITE_TITLE=Family Tree
MAX_UPLOAD_MB=5
SESSION_DAYS=14

# Argon2id cost. Lower these only on very small machines.
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=32768
ARGON2_PARALLELISM=2

# Force secure cookies on/off. Leave unset to derive from BASE_URL.
# COOKIE_SECURE=true

# --- mail relay: optional, not used by the UI yet -------------------------
# Set these to enable the SMTP mailer for future invite/reset notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
